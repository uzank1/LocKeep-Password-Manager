{
  "name": "lockeep-password-manager",
  "version": "1.0.8",
  "description": "LocKeep — Local-First, Zero-Knowledge Password Manager",
  "repository": {
    "type": "git",
    "url": "https://github.com/uzank1/LocKeep-Password-Manager.git"
  },
  "main": "src/main/main.js",
  "author": {
    "name": "Koray Uzan",
    "email": "s32kuzan@uni-bonn.de"
  },
  "private": true,
  "scripts": {
    "start": "electron .",
    "dev": "electron . --dev",
    "test": "npm run test:crypto && npm run test:vault && npm run test:content && npm run test:startup && npm run test:update && npm run test:window",
    "test:crypto": "node tests/crypto.test.js",
    "test:vault": "node tests/vault.test.js",
    "test:content": "node tests/content-script.test.js",
    "test:startup": "node tests/startup.test.js",
    "test:update": "node tests/update.test.js",
    "test:window": "node --test tests/window-close.test.js",
    "install-native-host": "node scripts/install-native-host.js",
    "dist": "electron-builder --config electron-builder.yml",
    "build": "npm run dist"
  },
  "dependencies": {
    "argon2": "^0.41.1",
    "electron-updater": "^6.8.9",
    "uuid": "^11.1.0"
  },
  "devDependencies": {
    "electron": "^42.3.3",
    "electron-builder": "^26.15.2"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
